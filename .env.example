# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model to use for server-side Gemini features (default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# AI_ENABLED: Master switch for AI capabilities ("true" or "false")
AI_ENABLED="true"

# AI_DAILY_LIMIT_PER_USER: Maximum AI generation calls allowed per user per day (default: 50)
AI_DAILY_LIMIT_PER_USER="50"


# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LMS_DEMO_MODE: Enables the dedicated Demo Login / Role Selection endpoint (/api/auth/demo-login)
# for development and project demonstrations. Set to "false" in strict production deployments.
LMS_DEMO_MODE="true"

# SESSION_SECRET: Cryptographic secret key used to HMAC-sign session tokens.
# Must be at least 32 characters in production. If omitted, an ephemeral secret is generated on startup.
SESSION_SECRET="replace-with-a-secure-random-secret-key-at-least-32-characters"

# ADMIN_EMAILS: Comma-separated list of email addresses granted administrator privileges on sign-in.
ADMIN_EMAILS="admin@smartlearn.edu"

